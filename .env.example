# Supabase public configuration (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase server-only secret key (NEVER expose to browser / NEXT_PUBLIC_*)
# Required for server-side admin actions (e.g., creating receptionist accounts in Phase 8/9)
SUPABASE_SERVICE_ROLE_KEY=
