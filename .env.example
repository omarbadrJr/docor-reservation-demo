# Supabase public configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as a fallback)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase server-only secret key (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
# Required for server-side booking RPCs, staff dashboards, doctor photo uploads, and staff provisioning
SUPABASE_SERVICE_ROLE_KEY=

# Optional password override used only by scripts/seed-demo-staff.ts in local/demo environments
# Defaults to DemoStaff!2026 if unset. Never run demo seeding against real production users.
# DEMO_STAFF_PASSWORD=
